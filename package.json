{
  "name": "node-laravel-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Node Laravel Style Framework",
  "author": "trexwb",
  "type": "module",
  "main": "./dist/src/public/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/public/index.ts",
    "build": "tsc && tsc-alias",
    "start": "node ./dist/src/public/index.js",
    "artisan": "node ./dist/src/artisan.js",
    "artisan:dev": "ts-node -r tsconfig-paths/register src/artisan.ts",
    "knex": "knex --knexfile src/database/knexfile.ts",
    "migrate:make": "npm run knex migrate:make -- -x ts",
    "migrate:latest": "npm run knex migrate:latest",
    "seed:make": "npm run knex seed:make -- -x ts",
    "seed:run": "npm run knex seed:run",
    "postinstall": "node ./install.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "knex": "^3.3.0",
    "lodash-es": "^4.18.1",
    "multer": "^2.2.0",
    "mysql2": "^3.24.2",
    "node-schedule": "^2.1.1",
    "objection": "^3.1.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.2.1",
    "sharp": "^0.35.4",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.2",
    "validatorjs": "^3.22.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.0",
    "@types/node-schedule": "^2.1.8",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@types/validatorjs": "^3.15.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "imports": {
    "#app/*": "./src/app/*.ts",
    "#bootstrap/*": "./src/bootstrap/*.ts",
    "#config/*": "./src/config/*.ts",
    "#database/*": "./src/database/*.ts",
    "#public/*": "./src/public/*.ts",
    "#resources/*": "./src/resources/*.ts",
    "#routes/*": "./src/routes/*.ts",
    "#storage/*": "./src/storage/*.ts",
    "#types/*": "./src/types/*.d.ts",
    "#utils/*": "./src/utils/*.ts"
  }
}
